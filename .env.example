# Server Configuration
PORT=3000
NODE_ENV=development

# Test Mode (bypasses PayPal for local development when network is restricted)
# Set to 'true' to use mock payments, 'false' to use real PayPal API
TEST_MODE=false

# PayPal Configuration
# Get your credentials from: https://developer.paypal.com/dashboard/
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_MODE=sandbox
# Change to 'live' for production

# Product Configuration
LICENSE_PRICE=29.99
CURRENCY_CODE=USD
BRAND_NAME=Your Extension Name

# Email Configuration
# Option 1: Gmail SMTP (Recommended - Easiest Setup)
# Get app password from: https://myaccount.google.com/apppasswords
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password

# Option 2: Custom SMTP (Alternative)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM_NAME=License System
SMTP_FROM_EMAIL=noreply@example.com
